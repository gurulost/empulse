APP_NAME=Empulse
APP_ENV=production
APP_KEY=
AUDIT_HASH_KEY=
APP_DEBUG=false
TRUSTED_PROXIES=
REQUIRE_PROCESS_HEARTBEATS=true
HEARTBEAT_MAX_AGE_SECONDS=180
APP_URL=https://empulse.example.com

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=empulse
DB_USERNAME=empulse
DB_PASSWORD=

CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

FILESYSTEM_DISK=public
AVATAR_DISK=public

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Empulse
BREVO_KEY=
BREVO_WEBHOOK_TOKEN=

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PULSE=
STRIPE_PRICE_ENTERPRISE=
BILLING_PRICE_STARTER_CENTS=
BILLING_PRICE_PULSE_CENTS=

SURVEY_WAVE_PROCESSING_TIMEOUT_MINUTES=30

LOGIN_URL="${APP_URL}/login"
TEST_URL="${APP_URL}"

VITE_APP_NAME="${APP_NAME}"
