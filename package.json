{
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "lint": "eslint resources/js tests/e2e tests/unit tests/load --ext .js,.vue",
        "test:unit": "vitest run",
        "audit:production": "npm audit --omit=dev --audit-level=high",
        "sass:check-imports": "if rg -n \"@import\\\\s+['\\\"]\" resources/sass --glob '*.scss'; then echo 'Sass @import is deprecated. Use @use/@forward.' && exit 1; else echo 'No Sass @import found in resources/sass.'; fi",
        "test:e2e": "playwright test"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.12.1",
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.52.0",
        "@vitejs/plugin-vue": "^6.0.8",
        "axios": "^1.18.0",
        "eslint": "^10.8.0",
        "eslint-plugin-vue": "^10.10.0",
        "globals": "^17.8.0",
        "jsdom": "^25.0.1",
        "laravel-vite-plugin": "^3.1.3",
        "lodash": "^4.17.24",
        "postcss": "^8.5.18",
        "sass": "^1.94.1",
        "vite": "^8.1.5",
        "vitest": "^4.1.10",
        "vue-eslint-parser": "^10.4.1"
    },
    "dependencies": {
        "@popperjs/core": "^2.11.8",
        "bootstrap": "^5.3.8",
        "chart.js": "^4.5.1",
        "vue": "^3.5.24",
        "vue-chartjs": "^5.3.3"
    }
}
