{
    "name": "empulse",
    "private": true,
    "type": "module",
    "engines": {
        "node": "^22.23.4 || ^24.22.1"
    },
    "scripts": {
        "predev": "node scripts/check-node-runtime.mjs",
        "dev": "vite",
        "prebuild": "node scripts/check-node-runtime.mjs",
        "build": "vite build",
        "lint": "eslint resources/js scripts tests/e2e tests/Unit tests/load playwright.config.js --ext .js,.mjs,.vue",
        "pretest:unit": "node scripts/check-node-runtime.mjs",
        "test:unit": "vitest run",
        "audit:production": "npm audit --omit=dev --audit-level=high",
        "sass:check-imports": "if rg -n \"@import\\\\s+['\\\"]\" resources/sass --glob '*.scss'; then echo 'Sass @import is deprecated. Use @use/@forward.' && exit 1; else echo 'No Sass @import found in resources/sass.'; fi",
        "pretest:e2e": "node scripts/check-node-runtime.mjs",
        "test:e2e": "playwright test"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.12.1",
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.64.1",
        "@vitejs/plugin-vue": "^6.0.8",
        "axios": "^1.20.0",
        "eslint": "^10.8.0",
        "eslint-plugin-vue": "^10.10.0",
        "globals": "^17.8.0",
        "jsdom": "^25.0.1",
        "laravel-vite-plugin": "^3.1.3",
        "lodash": "^4.17.24",
        "postcss": "^8.5.18",
        "sass": "^1.94.1",
        "vite": "^8.3.5",
        "vitest": "^4.1.12",
        "vue-eslint-parser": "^10.4.1"
    },
    "dependencies": {
        "@fontsource/dm-sans": "^5.2.6",
        "@fontsource/inter": "^5.2.6",
        "@fontsource/outfit": "^5.2.6",
        "@popperjs/core": "^2.11.8",
        "bootstrap": "^5.3.8",
        "bootstrap-icons": "^1.11.3",
        "chart.js": "^4.5.1",
        "vue": "^3.5.44",
        "vue-chartjs": "^5.3.3"
    }
}
